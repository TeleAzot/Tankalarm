@page "/NearbySearch"
@inject NavigationManager NavigationManager
@inject TankerkoenigService TankerkoenigService
@inject GeoCodeService GeoCodeService

<header class="d-flex">
    <h2>Umkreissuche</h2>
    <button class="icon-lg bi bi-house" @onclick="Home"></button>
</header>

<form @onsubmit="SearchFuelStations">
    <input @bind="useCurrentLocation" type="checkbox" id="currentLocation" />
    <label for="currentLocation">Aktuellen Standort benutzen</label>
    <br />

    @if (!useCurrentLocation)
    {
        <div class="autocomplete">
            <label for="customLocation">Standort suchen:</label>
            <input type="text"
                   id="customLocation"   
                   class="form-control"
                   @bind="CustomLocationQuery"
                   @bind:event="oninput" />

            @if (customLocationSuggestions != null)
            {
                <ul class="list-group">
                    @foreach (var loc in customLocationSuggestions)
                    {
                        <li class="list-group-item"
                            @onclick="() => SelectLocation(loc)">
                            @loc.LocationName
                        </li>
                    }
                </ul>
            }
        </div>
    }    

    <label for="fuelType">Spritsorte:</label>
    <select @bind="FuelType" id="fuelType" required>
        <option disabled selected>---Spritsorte wählen---</option>
        <option>E5</option>
        <option>Diesel</option>
    </select>
    <br />
    <label for="radius">Umkreis:</label>
    <select @bind="radius" id="radius" required>
        <option value="2">2 km</option>
        <option value="5" selected>5 km</option>
        <option value="10">10 km</option>
        <option value="20">20 km</option>
    </select>
    <br />
    <label for="sortby">Sortieren nach:</label>
    <select @bind="sortBy" id="sortby" required>
        <option value="PRICE" selected>Preis</option>
        <option value="DISTANCE">Distanz</option>
    </select>
    <br />
    <button type="submit">Suche starten</button>
</form>

@if (resultFuelStations != null)
{
    @foreach (var station in resultFuelStations)
    {
        <div class="station-card">
            <div class="station-header">
                <div class="station-name">@station.Name</div>

                @{
                    var price = station.Price.ToString("0.000");
                    var parts = price.Split('.');
                }
                <div class="station-price">
                    @parts[0],@parts[1].Substring(0, 2)<sup>@parts[1][2]</sup>&nbsp€
                </div>
            </div>

            <div class="station-address">
                @station.Street @station.City
            </div>

            <div class="station-footer">
                @station.Distance.ToString("0.0") km entfernt
            </div>
        </div>
    }
}
else if (resultFuelStations != null && resultFuelStations.Count() == 0)
{
    <p>Keine Tankstellen gefunden.</p>    
}

@code
{
    [SupplyParameterFromQuery(Name = "fuelType")]
    public string? FuelType { get; set; }
    public string CustomLocationQuery
    {
        get => field;
        set
        {
            if (field != value && selectedCustomLocation == null)
            {
                field = value;
                SearchChanged?.Invoke(value);
            }
        }
    }

    bool useCurrentLocation = true;
    int radius = 5;
    string sortBy;
    Coordinates selectedCustomLocation;

    private CancellationTokenSource? _cts;

    IEnumerable<FuelStation> resultFuelStations;
    IEnumerable<Coordinates> customLocationSuggestions;

    protected override async Task OnInitializedAsync()
    {
        SearchChanged += LoadCustomLocationSuggestions;
        if (!string.IsNullOrEmpty(FuelType))
            await SearchFuelStations();
        await base.OnInitializedAsync();
    }

    event Func<string, Task>? SearchChanged;
    private async Task LoadCustomLocationSuggestions(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || text.Length < 3)
        {
            customLocationSuggestions = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        await Task.Delay(300, _cts.Token); // Debounce

        customLocationSuggestions = await GeoCodeService.GetAutoCompleteCitySuggestionsAsync(CustomLocationQuery);

        await InvokeAsync(StateHasChanged);
    }

    private void SelectLocation(Coordinates location)
    {
        selectedCustomLocation = location;
        CustomLocationQuery = location.LocationName;
        customLocationSuggestions = null;
    }

    private async Task SearchFuelStations()
    {
        if (string.IsNullOrEmpty(FuelType))
            return;

        double lat, lon;
        if (useCurrentLocation)
        {
            //get current phone location
            DeviceLocation deviceLocation = new DeviceLocation();
            Location? currentLocation = await deviceLocation.GetCurrentDeviceLocationAsync();
            if (currentLocation == null)
                return;
            lat = 48.797592;
            lon = 10.024963;
        }
        else if (selectedCustomLocation != null)
        {
            lat = selectedCustomLocation.Latitude;
            lon = selectedCustomLocation.Longitude;
        }
        else
            return;

        if (sortBy == "DISTANCE")
            resultFuelStations = await TankerkoenigService.GetCheapestFuelPricesAsync(lon, lat, radius, FuelType, "dist");
        else
            resultFuelStations = await TankerkoenigService.GetCheapestFuelPricesAsync(lon, lat, radius, FuelType, "price");
    }

    private void Home()
    {
        NavigationManager.NavigateTo("/");
    }
}